# ==============================================================================
# SEEDSTACK ENVIRONMENT CONFIGURATION
# AI-Powered Farmer-to-Vendor Marketplace (Telangana & Andhra Pradesh)
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Credentials (Optional for Demo Mode; Required for Real Postgres/Auth)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage Bucket Names
NEXT_PUBLIC_SUPABASE_STORAGE_PRODUCE=produce-images
SUPABASE_STORAGE_DOCUMENTS=private-id-documents

# Routing & Maps Configuration
# OpenStreetMap / Leaflet runs out-of-the-box keyless for development
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional: Google Maps Routes API Key (Server-side only)
GOOGLE_MAPS_ROUTES_API_KEY=

# Market Price Data Sources (AGMARKNET / e-NAM / data.gov.in)
# Live API Key if registered on data.gov.in
DATA_GOV_IN_API_KEY=

# AI & Language Models (Optional - Baseline statistical & moving average models run locally)
OPENAI_API_KEY=
GEMINI_API_KEY=
